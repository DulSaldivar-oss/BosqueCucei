# Conexión a PostgreSQL (en docker compose el host es "db")
DATABASE_URL=postgres://bosque:bosque@localhost:5432/bosque

# URL pública del sitio (se usa en los códigos QR que se imprimen)
URL_SITIO=http://localhost:3000

# Carpeta donde se guardan las fotos de las observaciones
CARPETA_FOTOS=./.datos/fotos

# Base vacía para las pruebas de integración (npm test). Se borra en cada corrida.
# DATABASE_URL_PRUEBAS=postgres://bosque:bosque@localhost:5432/bosque_test
