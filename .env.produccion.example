# Copia este archivo como .env en la máquina de Oracle y ajusta los valores.

# Dominio público. Sin dominio propio puedes usar sslip.io con la IP pública:
#   DOMINIO=bosque.203-0-113-10.sslip.io
DOMINIO=bosque.ejemplo.mx

# Correo para Let's Encrypt (avisos de renovación del certificado).
CORREO_ACME=sustentabilidad@ejemplo.mx

# Contraseña de PostgreSQL: usa una larga y aleatoria (openssl rand -base64 24).
POSTGRES_PASSWORD=cambia-esta-contrasena

# Levanta también la app, las migraciones y Caddy (sin esto solo arranca la base).
COMPOSE_PROFILES=app
