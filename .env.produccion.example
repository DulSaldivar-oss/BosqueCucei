# Copia este archivo como .env en la máquina de Oracle y ajusta los valores.

# Dominio público que apunta a la IP de la máquina. Sin dominio propio puedes usar
# sslip.io con la IP pública:  DOMINIO=bosque.203-0-113-10.sslip.io
DOMINIO=bosque.ejemplo.mx

# Contraseña de PostgreSQL: solo letras y números (va dentro de una URL).
# Genera una con:  openssl rand -hex 24
POSTGRES_PASSWORD=cambia-esta-contrasena

# Levanta también la app, las migraciones y Caddy (sin esto solo arranca la base).
COMPOSE_PROFILES=app

# Fondo del mapa (opcional). Vacío = OpenStreetMap, que no necesita llave.
# Para otro proveedor, p. ej. MapTiler (llave gratis en maptiler.com, restríngela a tu dominio):
# MAPA_TILES_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key={llave}
# MAPA_TILES_LLAVE=tu-llave
# MAPA_TILES_ATRIBUCION=&copy; MapTiler &copy; OpenStreetMap
