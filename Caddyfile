# Caddy obtiene y renueva solo el certificado HTTPS (necesario para usar la cámara del teléfono).
# Let's Encrypt no necesita correo; con DOMINIO=localhost usa un certificado local.
{$DOMINIO} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
		# Nadie puede mostrar el sitio dentro de un iframe (evita el «clickjacking»).
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
		-Server
	}
	reverse_proxy app:3000
}
